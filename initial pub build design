Step 4: Create the Home Page
Fetch Data: In a real-world scenario, you would fetch data from an API. Here, we’ll use static data for simplicity.

jsx
Copy code
// pages/index.js
import axios from 'axios';
import { useState, useEffect } from 'react';
import PubList from '../components/PubList';
import NavBar from '../components/NavBar';

const Home = () => {
  const [pubs, setPubs] = useState([]);

  useEffect(() => {
    const fetchPubs = async () => {
      const result = await axios('/api/pubs');
      setPubs(result.data);
    };

    fetchPubs();
  }, []);

  return (
    <div>
      <NavBar />
      <div className="container mx-auto">
        <h1 className="text-4xl font-bold text-center my-8">Pub Comparison</h1>
        <PubList pubs={pubs} />
      </div>
    </div>
  );
};

export default Home;
