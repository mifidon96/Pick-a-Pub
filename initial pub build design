Step 3: Create Components
PubCard Component: A card to display each pub’s details.

jsx
Copy code
// components/PubCard.js
const PubCard = ({ pub }) => {
  return (
    <div className="max-w-sm rounded overflow-hidden shadow-lg m-4">
      <img className="w-full" src={pub.image} alt={pub.name} />
      <div className="px-6 py-4">
        <div className="font-bold text-xl mb-2">{pub.name}</div>
        <p className="text-gray-700 text-base">
          {pub.description}
        </p>
      </div>
    </div>
  );
};

export default PubCard;
PubList Component: A list to render multiple PubCard components.

jsx
Copy code
// components/PubList.js
import PubCard from './PubCard';

const PubList = ({ pubs }) => {
  return (
    <div className="flex flex-wrap justify-center">
      {pubs.map(pub => (
        <PubCard key={pub.id} pub={pub} />
      ))}
    </div>
  );
};

export default PubList;
