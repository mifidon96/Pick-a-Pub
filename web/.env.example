# Copy to .env.development.local for local development.
# (Only `next dev` reads that file, so the dev user can never leak into a production build.)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Local only: pretend to be this signed-in user (sent as the x-dev-user header).
# Leave unset in production.
NEXT_PUBLIC_DEV_USER=dev-user-1

# Production: fill these from `terraform output`.
# NEXT_PUBLIC_COGNITO_AUTHORITY=https://cognito-idp.eu-west-2.amazonaws.com/<user_pool_id>
# NEXT_PUBLIC_COGNITO_CLIENT_ID=<client_id>
